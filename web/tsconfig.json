{
  "extends": "astro/tsconfigs/strict",
  "include": ["src/**/*", ".astro/**/*"],
  "exclude": ["dist", "node_modules"],
  "compilerOptions": {
    "baseUrl": "./",
    "paths": {
      "@components/*": ["src/components/*"],
      "@layouts/*": ["src/layouts/*"],
      "@lib/*": ["src/lib/*"],
      "@config/*": ["src/config/*"]
    },
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  }
}
